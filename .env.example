# ATM Apparel Shopping App environment template
# Copy this file to .env and populate the values for your local environment.
# Never commit real secrets or credentials to GitHub.

# Common app settings
NODE_ENV=development
PORT=3000

# PostgreSQL connection string required for database-backed API routes
# Example: postgresql://postgres:postgres@localhost:5432/atm_apparel
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atm_apparel

# Shopify Storefront configuration used by the API server at runtime
# Required only if Shopify product/cart routes are enabled.
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here

# Optional: used by the Expo app when connecting to the local API server
# Update to match the URL exposed by your dev API server.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_USE_SHOPIFY=false
